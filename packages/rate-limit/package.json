{
    "name": "@loanms/rate-limit",
    "version": "0.0.1",
    "author": "4thDEVisionTech",
    "description": "LoanMS exact rate-limit coordination for Cloudflare Workers",
    "type": "module",
    "private": true,
    "license": "ISC",
    "engines": {
        "node": ">=26.8.1",
        "pnpm": ">=12.8.1"
    },
    "scripts": {
        "build": "tsc --build ./tsconfig.build.json",
        "build:force": "tsc --build ./tsconfig.build.json --clean && pnpm run build",
        "check": "tsc --noEmit",
        "format": "eslint . --fix && prettier --write . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
        "lint": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore && eslint .",
        "prepare": "pnpm build",
        "test:con": "vitest run --no-color"
    },
    "dependencies": {
        "@loanms/errors": "workspace:*"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "catalog:",
        "vitest": "catalog:"
    },
    "exports": {
        "./client": {
            "types": "./dist/client.d.ts",
            "default": "./dist/client.js"
        },
        "./policy": {
            "types": "./dist/policy.d.ts",
            "default": "./dist/policy.js"
        },
        "./server": {
            "types": "./dist/server.d.ts",
            "default": "./dist/server.js"
        },
        "./transport": {
            "types": "./dist/transport.d.ts",
            "default": "./dist/transport.js"
        }
    }
}
