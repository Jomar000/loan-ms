{
    "name": "@hyperion/ui",
    "version": "0.0.1",
    "author": "4thDEVisionTech",
    "description": "Hyperion UI Component Library (shadcn-svelte)",
    "type": "module",
    "private": true,
    "license": "ISC",
    "engines": {
        "node": ">=26.8.1",
        "pnpm": ">=12.8.1"
    },
    "scripts": {
        "build": "svelte-package",
        "check": "svelte-check --tsconfig ./tsconfig.json",
        "format": "eslint . --fix && prettier --write . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
        "lint": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore && eslint .",
        "prepare": "pnpm build"
    },
    "exports": {
        "./components/*": {
            "types": "./dist/components/*/index.d.ts",
            "svelte": "./dist/components/*/index.js",
            "default": "./dist/components/*/index.js"
        },
        "./hooks": {
            "types": "./dist/hooks/index.d.ts",
            "default": "./dist/hooks/index.js"
        },
        "./overrides/*": {
            "types": "./dist/overrides/*/index.d.ts",
            "svelte": "./dist/overrides/*/index.js",
            "default": "./dist/overrides/*/index.js"
        },
        "./shared/*": {
            "types": "./dist/shared/*/index.d.ts",
            "svelte": "./dist/shared/*/index.js",
            "default": "./dist/shared/*/index.js"
        },
        "./styles": "./dist/styles/globals.css",
        "./utils": {
            "types": "./dist/utils.d.ts",
            "default": "./dist/utils.js"
        }
    },
    "files": [
        "dist",
        "!dist/**/*.test.*",
        "!dist/**/*.spec.*"
    ],
    "devDependencies": {
        "@internationalized/date": "catalog:",
        "@lucide/svelte": "catalog:",
        "@sveltejs/package": "catalog:",
        "@sveltejs/vite-plugin-svelte": "catalog:",
        "@tanstack/table-core": "catalog:",
        "bits-ui": "catalog:",
        "chart.js": "catalog:",
        "clsx": "catalog:",
        "embla-carousel-svelte": "catalog:",
        "formsnap": "catalog:",
        "hls.js": "catalog:",
        "inapp-spy": "catalog:",
        "mode-watcher": "catalog:",
        "paneforge": "catalog:",
        "shadcn-svelte": "catalog:",
        "svelte": "catalog:",
        "svelte-check": "catalog:",
        "svelte-sonner": "catalog:",
        "sveltekit-superforms": "catalog:",
        "tailwind-merge": "catalog:",
        "tailwind-variants": "catalog:",
        "tailwindcss": "catalog:",
        "tw-animate-css": "catalog:",
        "vaul-svelte": "catalog:"
    },
    "peerDependencies": {
        "svelte": "^5.0.0"
    }
}
