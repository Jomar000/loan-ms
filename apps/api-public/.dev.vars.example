BETTER_AUTH_SECRET="better-auth-secret-12345678901234567890"

##############
# CloudFlare #
##############

CF_ACCOUNT_ID="<ACCOUNT_ID>"

# DO
CF_DO_RATE_LIMIT_SECRET="cf-do-rate-limit-secret-123456789012345678901234"

# R2
# https://developers.cloudflare.com/r2
CF_R2_ACCESS_KEY_ID="<ACCESS_KEY_ID>"
CF_R2_SECRET_ACCESS_KEY="<SECRET_ACCESS_KEY>"

# Turnstile
# https://developers.cloudflare.com/turnstile/troubleshooting/testing
CF_TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

##########
# Google #
##########

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

###################
# E-mail Provider #
###################

# MAILER_PROVIDER and MAILER_ACCOUNT are non-secret Wrangler variables.
# Required only when FEATURE_MAIL=1 and MAILER_PROVIDER="resend".
# Cloudflare Email Sending uses the HYPERIONPUB_EMAIL binding instead.
RESEND_API_KEY=""
